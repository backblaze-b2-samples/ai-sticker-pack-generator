# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=<your-25-char-key-id>
# B2_APPLICATION_KEY=<your-31-char-application-key>
# B2_BUCKET_NAME=my-sticker-packs

# Optional: public base URL for your bucket (only if the bucket is public).
# When set, file/sticker responses include a direct public URL; otherwise the
# app serves short-lived presigned URLs. Leave unset for presigned-only.
# B2_PUBLIC_URL=https://my-sticker-packs.s3.us-west-004.backblazeb2.com

# OpenAI (required for sticker generation)
# Used server-side only to call the gpt-image-1 image-generation model.
# Never exposed to the browser. See docs/SECURITY.md.
OPENAI_API_KEY=your_openai_api_key
